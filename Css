/* ===============================
   FREELANCE HUB - STYLES
   Rename "PLACEHOLDER HUB NAME" in hub's index.html to your real brand.
   =============================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: #080808;
    color: #ffffff;
    font-family: 'Segoe UI', Arial, sans-serif;
    line-height: 1.6;
}

.hub-header {
    text-align: center;
    padding: 70px 20px 40px;
}

.hub-header p {
    color: #d4af37;
    letter-spacing: 2px;
    font-size: 13px;
    margin-bottom: 10px;
}

.hub-header h1 {
    font-size: 34px;
    margin-bottom: 12px;
}

.hub-header span {
    color: #d4af37;
}

.hub-header .subtitle {
    color: #999999;
    max-width: 500px;
    margin: 0 auto;
    font-size: 15px;
}

.hub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 25px;
    max-width: 1000px;
    margin: 0 auto;
    padding: 20px 25px 90px;
}

.hub-card {
    display: block;
    background: #111111;
    border: 1px solid #292313;
    border-radius: 10px;
    padding: 30px 25px;
    text-align: center;
    text-decoration: none;
    color: #ffffff;
    transition: 0.3s;
}

.hub-card:hover {
    border-color: #d4af37;
    transform: translateY(-4px);
}

.hub-card .hub-icon {
    font-size: 34px;
    display: block;
    margin-bottom: 14px;
}

.hub-card h2 {
    font-size: 18px;
    margin-bottom: 8px;
}

.hub-card p {
    color: #999999;
    font-size: 13px;
}

.hub-card.disabled {
    opacity: 0.5;
    cursor: default;
    pointer-events: none;
    border-style: dashed;
}

.hub-footer {
    text-align: center;
    padding: 25px;
    color: #666666;
    font-size: 13px;
    border-top: 1px solid #1c1c1c;
}

@media (max-width: 500px) {
    .hub-header h1 {
        font-size: 26px;
    }
}
